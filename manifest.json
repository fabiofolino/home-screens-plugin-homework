{
  "id": "fab-homework",
  "name": "FAB Homework",
  "version": "1.0.1",
  "description": "Displays the weekly homework feed generated for the family dashboard.",
  "author": "FAB Business Technology",
  "license": "MIT",
  "minAppVersion": "1.12.0",
  "moduleType": "fab-homework",
  "category": "Personal",
  "icon": "BookOpen",
  "defaultConfig": {
    "feedUrl": "http://192.168.0.42:8787/homework-5th.json",
    "refreshIntervalMs": 300000,
    "layout": "columns",
    "maxItems": 20,
    "maxColumns": 6,
    "showDetails": true,
    "showDueDate": true,
    "showUpdated": true,
    "showNotes": false,
    "hidePastDue": false,
    "highlightDueSoon": true,
    "density": "compact",
    "detailLines": 2
  },
  "defaultSize": {
    "w": 1000,
    "h": 560
  },
  "defaultStyle": {
    "fontSize": 14,
    "padding": 10,
    "borderRadius": 16,
    "backgroundColor": "rgba(0,0,0,0.35)"
  },
  "exports": {
    "component": "default"
  },
  "permissions": [
    "network",
    "localNetwork"
  ],
  "allowedDomains": [
    "192.168.0.42"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "feedUrl": {
        "type": "string",
        "title": "Homework feed URL",
        "description": "JSON feed generated by the homework collector.",
        "ui:widget": "text"
      },
      "refreshIntervalMs": {
        "type": "number",
        "title": "Refresh interval",
        "description": "How often to refresh the feed, in milliseconds.",
        "minimum": 60000,
        "maximum": 3600000,
        "ui:widget": "number"
      },
      "layout": {
        "type": "string",
        "title": "Layout",
        "enum": [
          "columns",
          "list",
          "due-soon"
        ],
        "enumLabels": [
          "Subject columns",
          "Chronological list",
          "Due soon"
        ],
        "ui:widget": "select"
      },
      "density": {
        "type": "string",
        "title": "Content density",
        "enum": [
          "compact",
          "comfortable"
        ],
        "enumLabels": [
          "Compact (recommended)",
          "Comfortable"
        ],
        "ui:widget": "select"
      },
      "maxItems": {
        "type": "number",
        "title": "Maximum assignments",
        "minimum": 1,
        "maximum": 100,
        "ui:widget": "number"
      },
      "maxColumns": {
        "type": "number",
        "title": "Maximum subject columns",
        "minimum": 1,
        "maximum": 8,
        "ui:widget": "slider",
        "ui:step": 1,
        "ui:showWhen": {
          "field": "layout",
          "equals": "columns"
        }
      },
      "showDetails": {
        "type": "boolean",
        "title": "Show assignment details",
        "ui:widget": "toggle"
      },
      "detailLines": {
        "type": "number",
        "title": "Detail lines per assignment",
        "minimum": 1,
        "maximum": 4,
        "ui:widget": "slider",
        "ui:step": 1,
        "ui:showWhen": {
          "field": "showDetails",
          "equals": true
        }
      },
      "showDueDate": {
        "type": "boolean",
        "title": "Show due date",
        "ui:widget": "toggle"
      },
      "showUpdated": {
        "type": "boolean",
        "title": "Show last updated time",
        "ui:widget": "toggle"
      },
      "showNotes": {
        "type": "boolean",
        "title": "Show weekly notes",
        "ui:widget": "toggle"
      },
      "hidePastDue": {
        "type": "boolean",
        "title": "Hide past-due assignments",
        "ui:widget": "toggle"
      },
      "highlightDueSoon": {
        "type": "boolean",
        "title": "Highlight overdue, today, and tomorrow",
        "ui:widget": "toggle"
      }
    }
  }
}
